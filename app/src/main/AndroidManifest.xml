<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="ComfyUI 远程面板"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">
        <activity android:name=".GalleryActivity" />
        <activity android:name=".QueueActivity" />
        <activity
            android:name=".MaskEditorActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".SplashActivity"
            android:screenOrientation="portrait"
            android:exported="true" />

        <!-- V2.2 launcher aliases: Android can switch bundled launcher icons without rebuilding the APK. -->
        <activity-alias
            android:name=".LauncherDefault"
            android:targetActivity=".SplashActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="ComfyUI 远程面板">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherMinimal"
            android:targetActivity=".SplashActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_minimal"
            android:label="ComfyUI 远程面板">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherBlue"
            android:targetActivity=".SplashActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_blue"
            android:label="ComfyUI 远程面板">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
